# AWS-focused production environment template (copy to real .env in AWS runtime)
APP_NAME=QRPay
APP_ENV=production
APP_KEY={{APP_KEY}}              # Generate and set securely (Secrets Manager / ECS Secrets)
APP_DEBUG=false
APP_URL={{APP_URL}}
ASSET_URL={{ASSET_URL}}         # e.g. https://cdn.example.com if using CloudFront

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null
LOG_STACK_CHANNELS=single

# Database (use Amazon RDS)
DB_CONNECTION=mysql
DB_HOST={{RDS_ENDPOINT}}
DB_PORT=3306
DB_DATABASE={{RDS_DB_NAME}}
DB_USERNAME={{RDS_USERNAME}}
DB_PASSWORD={{RDS_PASSWORD}}

# Cache / Queue / Session (AWS ElastiCache + SQS)
CACHE_STORE=redis
CACHE_DRIVER=redis
QUEUE_CONNECTION=sqs
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Redis
REDIS_HOST={{ELASTICACHE_ENDPOINT}}
REDIS_PASSWORD=null
REDIS_PORT=6379

# Filesystem (AWS S3)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID={{AWS_ACCESS_KEY_ID}}            # Recommended: inject via ECS secret, not plaintext
AWS_SECRET_ACCESS_KEY={{AWS_SECRET_ACCESS_KEY}}
AWS_DEFAULT_REGION={{AWS_REGION}}
AWS_BUCKET={{S3_BUCKET}}
AWS_USE_PATH_STYLE_ENDPOINT=false

# Mail (AWS SES)
MAIL_MAILER=ses
AWS_SES_REGION={{AWS_SES_REGION}}

# Pusher (optional)
PUSHER_APP_ID={{PUSHER_APP_ID}}
PUSHER_APP_KEY={{PUSHER_APP_KEY}}
PUSHER_APP_SECRET={{PUSHER_APP_SECRET}}
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# Vite
VITE_APP_NAME="${APP_NAME}"
