APP_NAME=Laravel
APP_ENV=production
# IMPORTANT: set a real, base64-encoded key in production
APP_KEY={{APP_KEY}}
APP_DEBUG=false
APP_URL={{APP_URL}}

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null
LOG_STACK_CHANNELS=single

# Database
DB_CONNECTION=mysql
DB_HOST={{DB_HOST}}
DB_PORT=3306
DB_DATABASE={{DB_DATABASE}}
DB_USERNAME={{DB_USERNAME}}
DB_PASSWORD={{DB_PASSWORD}}

# Caching / Queues / Sessions
BROADCAST_DRIVER=log
CACHE_STORE=file
CACHE_DRIVER=file
CACHE_PREFIX=
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Redis (optional)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail
MAIL_MAILER=smtp
MAIL_HOST={{MAIL_HOST}}
MAIL_PORT=587
MAIL_USERNAME={{MAIL_USERNAME}}
MAIL_PASSWORD={{MAIL_PASSWORD}}
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS={{MAIL_FROM_ADDRESS}}
MAIL_FROM_NAME="${APP_NAME}"

# Pusher (optional)
PUSHER_APP_ID={{PUSHER_APP_ID}}
PUSHER_APP_KEY={{PUSHER_APP_KEY}}
PUSHER_APP_SECRET={{PUSHER_APP_SECRET}}
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# Vite
VITE_APP_NAME="${APP_NAME}"
