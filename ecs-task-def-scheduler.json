{
  "family": "qrpay-scheduler",
  "networkMode": "awsvpc",
  "cpu": "256",
  "memory": "512",
  "requiresCompatibilities": ["FARGATE"],
  "executionRoleArn": "arn:aws:iam::{{AWS_ACCOUNT_ID}}:role/{{ECS_TASK_EXECUTION_ROLE}}",
  "taskRoleArn": "arn:aws:iam::{{AWS_ACCOUNT_ID}}:role/{{ECS_TASK_ROLE}}",
  "containerDefinitions": [
    {
      "name": "scheduler",
      "image": "{{IMAGE_NAME}}",
      "essential": true,
      "command": ["php","artisan","schedule:run"],
      "environment": [
        { "name": "APP_ENV", "value": "production" }
      ],
      "secrets": [
        { "name": "APP_KEY", "valueFrom": "{{SM_APP_KEY_ARN}}" },
        { "name": "DB_HOST", "valueFrom": "{{SM_DB_HOST_ARN}}" },
        { "name": "DB_DATABASE", "valueFrom": "{{SM_DB_NAME_ARN}}" },
        { "name": "DB_USERNAME", "valueFrom": "{{SM_DB_USER_ARN}}" },
        { "name": "DB_PASSWORD", "valueFrom": "{{SM_DB_PASS_ARN}}" },
        { "name": "REDIS_HOST", "valueFrom": "{{SM_REDIS_HOST_ARN}}" },
        { "name": "AWS_BUCKET", "valueFrom": "{{SM_S3_BUCKET_ARN}}" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/qrpay-scheduler",
          "awslogs-region": "{{AWS_REGION}}",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
