# Example overrides for local Docker compose
# Copy to .env.docker and adjust as needed. These values are for development only.

# App
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
MIGRATE_ON_BOOT=true

# Database
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=qrpay
DB_USERNAME=qrpay
DB_PASSWORD=qrpay
DB_ROOT_PASSWORD=root

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CLIENT=phpredis

# Mail (optional for local)
MAIL_MAILER=log
